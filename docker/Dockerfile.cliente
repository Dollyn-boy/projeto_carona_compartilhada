# Dockerfile do cliente unico do VaiJunto (cmd/cliente) — atende
# motorista e passageiro no mesmo binario, o papel e escolhido no
# cadastro/login em tempo de execucao, nao na hora do build.
#
# Mesmo padrao multi-stage do Dockerfile.servidor — ver os comentarios
# la para a explicacao completa de cada instrucao.

FROM golang:1.26-alpine AS build
WORKDIR /app
COPY . .
RUN CGO_ENABLED=0 go build -o /cliente ./cmd/cliente

FROM alpine:latest
COPY --from=build /cliente /cliente

# Sem EXPOSE aqui: o cliente nao escuta porta nenhuma, ele so conecta
# no servidor.
#
# ENTRYPOINT (em vez de CMD) significa que qualquer argumento passado
# depois do nome da imagem no "docker run" e ANEXADO a este comando —
# e assim que passamos a flag -servidor:
#   docker run -it vaijunto-cliente -servidor servidor:8080
#
# -it e necessario aqui (interativo + pseudo-terminal) porque o cliente
# pede input pelo terminal (cadastro, login, menus).
ENTRYPOINT ["/cliente"]
